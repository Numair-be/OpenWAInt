OPENWA_URL=http://localhost:2785
OPENWA_KEY=your-openwa-api-key
OPENWA_SESSION=your-session-id
RELAY_TOKEN=change-me-to-a-long-random-string
# Optional: ws://host:2785/events — derived from OPENWA_URL if unset
# OPENWA_EVENTS_URL=ws://host.docker.internal:2785/events
# INBOUND_LISTENER=false to disable WhatsApp keyword forwarding
PORT=3000
MIN_DELAY_MS=2000
MAX_DELAY_MS=5000

# Alert options (all optional)
DEFAULT_CHANNEL=alerts
THROTTLE_MINUTES=5
TZ=Asia/Kolkata
